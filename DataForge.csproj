<?xml version="1.0" encoding="utf-8"?>
<Project ToolsVersion="4.0" DefaultTargets="Build" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
    <Import Project="$(MSBuildExtensionsPath)\$(MSBuildToolsVersion)\Microsoft.Common.props" Condition="Exists('$(MSBuildExtensionsPath)\$(MSBuildToolsVersion)\Microsoft.Common.props')"/>
    <Import Project="environment.props"/>
    <PropertyGroup>
        <Configuration Condition=" '$(Configuration)' == '' ">Debug</Configuration>
        <Platform Condition=" '$(Platform)' == '' ">AnyCPU</Platform>
        <ProjectGuid>{4358610B-F3F4-4843-B7AF-98B7BC60DCDE}</ProjectGuid>
        <OutputType>Library</OutputType>
        <AppDesignerFolder>Properties</AppDesignerFolder>
        <RootNamespace>DataForge</RootNamespace>
        <AssemblyName>DataForge</AssemblyName>
        <TargetFrameworkVersion>v4.8</TargetFrameworkVersion>
        <FileAlignment>512</FileAlignment>
        <LangVersion>preview</LangVersion>
        <Nullable>enable</Nullable>
    </PropertyGroup>
    <PropertyGroup Condition=" '$(Configuration)|$(Platform)' == 'Debug|AnyCPU' ">
        <PlatformTarget>AnyCPU</PlatformTarget>
        <DebugSymbols>true</DebugSymbols>
        <DebugType>full</DebugType>
        <Optimize>false</Optimize>
        <OutputPath>bin\Debug\</OutputPath>
        <DefineConstants>DEBUG;TRACE</DefineConstants>
        <ErrorReport>prompt</ErrorReport>
        <WarningLevel>4</WarningLevel>
        <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    </PropertyGroup>
    <PropertyGroup Condition=" '$(Configuration)|$(Platform)' == 'Release|AnyCPU' ">
        <PlatformTarget>AnyCPU</PlatformTarget>
        <DebugType>pdbonly</DebugType>
        <Optimize>true</Optimize>
        <OutputPath>bin\Release\</OutputPath>
        <DefineConstants>TRACE</DefineConstants>
        <ErrorReport>prompt</ErrorReport>
        <WarningLevel>4</WarningLevel>
        <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    </PropertyGroup>
    <Choose>
        <When Condition="($(OS) == 'Unix' OR $(OS) == 'OSX') AND $(GamePath) == ''">
            <PropertyGroup>
                <GamePath Condition="!Exists('$(GamePath)')">$(HOME)/.steam/steam/steamapps/common/Valheim</GamePath>
                <GamePath Condition="!Exists('$(GamePath)')">$(HOME)/Library/Application Support/Steam/steamapps/common/Valheim/Contents/MacOS</GamePath>
                <CorlibPath Condition="!Exists('$(CorlibPath)') AND Exists('$(GamePath)')">$(GamePath)\valheim_Data\Managed</CorlibPath>
                <CorlibPath Condition="!Exists('$(CorlibPath)')">$(GamePath)/unstripped_corelib</CorlibPath>
            </PropertyGroup>
        </When>
        <When Condition="($(OS) == 'Windows_NT') AND $(GamePath) == ''">
            <PropertyGroup>
                <GamePath Condition="!Exists('$(GamePath)')">$([MSBuild]::GetRegistryValueFromView('HKEY_LOCAL_MACHINE\SOFTWARE\Microsoft\Windows\CurrentVersion\Uninstall\Steam App 892970', 'InstallLocation', null, RegistryView.Registry64, RegistryView.Registry32))</GamePath>
                <_SteamLibraryPath>$([MSBuild]::GetRegistryValueFromView('HKEY_CURRENT_USER\SOFTWARE\Valve\Steam', 'SteamPath', null, RegistryView.Registry32))</_SteamLibraryPath>
                <GamePath Condition="!Exists('$(GamePath)') AND '$(_SteamLibraryPath)' != ''">$(_SteamLibraryPath)\steamapps\common\Valheim</GamePath>
                <GamePath Condition="!Exists('$(GamePath)') AND Exists('$(ValheimGamePath)')">$(ValheimGamePath)</GamePath>
                <GamePath Condition="!Exists('$(GamePath)')">C:\Program Files\Steam\steamapps\common\Valheim</GamePath>
                <GamePath Condition="!Exists('$(GamePath)')">C:\Program Files (x86)\Steam\steamapps\common\Valheim</GamePath>
                <GamePath Condition="!Exists('$(GamePath)')">D:\SteamLibrary\steamapps\common\Valheim</GamePath>
                <BepInExPath Condition="!Exists('$(BepInExPath)')AND Exists('$(GamePath)')">$(GamePath)\BepInEx</BepInExPath>
                <CorlibPath Condition="!Exists('$(CorlibPath)') AND Exists('$(GamePath)')">$(GamePath)\valheim_Data\Managed</CorlibPath>
                <CorlibPath Condition="!Exists('$(CorlibPath)') AND Exists('$(GamePath)')">$(GamePath)\unstripped_corlib</CorlibPath>
                <PublicizedAssembliesPath Condition="!Exists('$(PublicizedAssembliesPath)') AND Exists('$(GamePath)')">$(GamePath)\valheim_Data\Managed\publicized_assemblies</PublicizedAssembliesPath>
                <AfterTargets Condition="'$(AfterTargets)' == ''">ILRepacker</AfterTargets>
            </PropertyGroup>
        </When>
    </Choose>
    <ItemGroup>
        <Reference Include="0Harmony">
            <HintPath>$(BepInExPath)\core\0Harmony.dll</HintPath>
        </Reference>
        <Reference Include="assembly_guiutils">
            <HintPath>$(PublicizedAssembliesPath)\assembly_guiutils_publicized.dll</HintPath>
        </Reference>
        <Reference Include="assembly_utils">
            <HintPath>$(PublicizedAssembliesPath)\assembly_utils_publicized.dll</HintPath>
        </Reference>
        <Reference Include="assembly_valheim">
            <HintPath>$(PublicizedAssembliesPath)\assembly_valheim_publicized.dll</HintPath>
        </Reference>
        <Reference Include="BepInEx">
            <HintPath>$(BepInExPath)\core\BepInEx.dll</HintPath>
        </Reference>
        <Reference Include="ServerSync">
            <HintPath>Libs\ServerSync.dll</HintPath>
        </Reference>
        <Reference Include="System"/>
        <Reference Include="System.Core"/>
        <Reference Include="System.Data"/>
        <Reference Include="System.Xml"/>
        <Reference Include="netstandard">
            <HintPath>$(CorlibPath)\netstandard.dll</HintPath>
            <Private>False</Private>
        </Reference>
        <Reference Include="UnityEngine">
            <HintPath>$(CorlibPath)\UnityEngine.dll</HintPath>
        </Reference>
        <Reference Include="UnityEngine.AssetBundleModule">
            <HintPath>$(CorlibPath)\UnityEngine.AssetBundleModule.dll</HintPath>
        </Reference>
        <Reference Include="UnityEngine.CoreModule">
            <HintPath>$(CorlibPath)\UnityEngine.CoreModule.dll</HintPath>
        </Reference>
        <Reference Include="UnityEngine.IMGUIModule">
            <HintPath>$(CorlibPath)\UnityEngine.IMGUIModule.dll</HintPath>
        </Reference>
        <Reference Include="UnityEngine.ImageConversionModule">
            <HintPath>$(CorlibPath)\UnityEngine.ImageConversionModule.dll</HintPath>
        </Reference>
        <Reference Include="UnityEngine.InputLegacyModule">
            <HintPath>$(CorlibPath)\UnityEngine.InputLegacyModule.dll</HintPath>
        </Reference>
        <Reference Include="UnityEngine.ParticleSystemModule">
            <HintPath>$(CorlibPath)\UnityEngine.ParticleSystemModule.dll</HintPath>
        </Reference>
        <Reference Include="UnityEngine.UI">
            <HintPath>$(CorlibPath)\UnityEngine.UI.dll</HintPath>
        </Reference>
        <Reference Include="Unity.TextMeshPro">
            <HintPath>$(GamePath)\valheim_Data\Managed\Unity.TextMeshPro.dll</HintPath>
        </Reference>
        <Reference Include="YamlDotNet">
            <HintPath>$(USERPROFILE)\.nuget\packages\yamldotnet\16.3.0\lib\net47\YamlDotNet.dll</HintPath>
            <Private>True</Private>
        </Reference>
    </ItemGroup>
    <ItemGroup>
        <Compile Include="LocalizationOverrideManager.cs"/>
        <Compile Include="Plugin.cs"/>
        <Compile Include="DataForgeConsoleCommands.cs"/>
        <Compile Include="DataForgeLogContext.cs"/>
        <Compile Include="DataForgeIconProtocol.cs"/>
        <Compile Include="DataForgeReferenceSections.cs"/>
        <Compile Include="DataForgeItemSortClassifier.cs"/>
        <Compile Include="DataForgeResourceMap.cs"/>
        <Compile Include="DataForgeValue.cs"/>
        <Compile Include="DataForgeSync.cs"/>
        <Compile Include="DataForgeIconSync.cs"/>
        <Compile Include="DataForgeOverrideFiles.cs"/>
        <Compile Include="DomainEntryChangeTracker.cs"/>
        <Compile Include="DataForgeFileWatcher.cs"/>
        <Compile Include="DataForgeLifecyclePatches.cs"/>
        <Compile Include="GeneratedArtifactWriter.cs"/>
        <Compile Include="ItemAcquisitionMultiplierPatches.cs"/>
        <Compile Include="ItemVisualOverrides.cs"/>
        <Compile Include="MaterialReferenceWriter.cs"/>
        <Compile Include="Properties\AssemblyInfo.cs"/>
        <Compile Include="ItemOverrideManager.cs"/>
        <Compile Include="RecipeOverrideManager.cs"/>
        <Compile Include="ArcheryTargetGuard.cs"/>
        <Compile Include="PieceComfortHudBadges.cs"/>
        <Compile Include="FireplaceFuelOverflow.cs"/>
        <Compile Include="StationExtensionSpacingBypass.cs"/>
        <Compile Include="PieceTableCategoryGuard.cs"/>
        <Compile Include="DataForgeVneiTypes.cs"/>
        <Compile Include="VneiPrefabCleanupGuard.cs"/>
        <Compile Include="VneiRefreshManager.cs"/>
        <Compile Include="ReferenceDefaultRules.cs"/>
        <Compile Include="ReferenceValue.cs"/>
        <Compile Include="StatusEffectOwnershipApi.cs"/>
        <Compile Include="StatusEffectOverrideManager.cs"/>
        <Compile Include="PieceOverrideManager.cs"/>
    </ItemGroup>
    <ItemGroup>
        <Content Include=".gitignore"/>
        <Content Include="environment.props"/>
        <Content Include="ILRepack.targets"/>
        <Content Include="Libs\ServerSync.dll">
            <CopyToOutputDirectory>Always</CopyToOutputDirectory>
        </Content>
        <Content Include="LICENSE.txt"/>
        <Content Include="README.md"/>
        <Content Include="Thunderstore\CHANGELOG.md"/>
        <Content Include="Thunderstore\icon.png"/>
        <Content Include="Thunderstore\manifest.json"/>
        <Content Include="UpdateManifest.ps1"/>
    </ItemGroup>
    <ItemGroup>
        <None Include="App.config"/>
    </ItemGroup>
    <ItemGroup>
        <PackageReference Include="ILRepack.Lib.MSBuild.Task" Version="2.0.44.1">
          <PrivateAssets>all</PrivateAssets>
          <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
        </PackageReference>
        <PackageReference Include="YamlDotNet" Version="16.3.0" />
    </ItemGroup>
    <Import Project="$(MSBuildToolsPath)\Microsoft.CSharp.targets"/>
    <!-- To modify your build process, add your task inside one of the targets below and uncomment it. 
         Other similar extension points exist, see Microsoft.Common.targets.
    <Target Name="BeforeBuild">
    </Target>
    <Target Name="AfterBuild">
    </Target>
    -->
    <UsingTask AssemblyFile="KeyManager.dll" TaskName="KeyManager.Seal" Condition="'$(AfterTargets)' == 'KeyManager'"/>
    <Target Name="KeyManager" AfterTargets="ILRepack" Condition="'$(AfterTargets)' == 'KeyManager'">
        <Seal DLL="$(TargetPath)"/>
    </Target>
    <Target Name="GetAssemblyVersion">
        <GetAssemblyIdentity AssemblyFiles="$(TargetPath)">
            <Output TaskParameter="Assemblies" ItemName="Targets"/>
        </GetAssemblyIdentity>
        <ItemGroup>
            <AssemblyVersions Include="@(Targets->'%(Version)')"/>
        </ItemGroup>
        <Error Text="Failed to get Assembly Version." Condition="'%(AssemblyVersions.Identity)' == ''"/>
        <PropertyGroup>
            <AssemblyVersion>%(AssemblyVersions.Identity)</AssemblyVersion>
            <Major>$(AssemblyVersion.Split('.')[0])</Major>
            <Minor>$(AssemblyVersion.Split('.')[1])</Minor>
            <Patch>$(AssemblyVersion.Split('.')[2])</Patch>
            <PackageName>$(AssemblyName)_v$(Major).$(Minor).$(Patch)</PackageName>
            <PackageVersion>$(Major).$(Minor).$(Patch)</PackageVersion>
            <VersionString>$(Major).$(Minor).$(Patch)</VersionString>
            <PackageStagingRoot Condition="'$(PackageStagingRoot)' == ''">$(IntermediateOutputPath)PackageStaging</PackageStagingRoot>
            <ThunderstorePackageOutputDir Condition="'$(ThunderstorePackageOutputDir)' == ''">$(ProjectDir)Thunderstore</ThunderstorePackageOutputDir>
            <NexusPackageOutputDir Condition="'$(NexusPackageOutputDir)' == ''">$(ProjectDir)Nexus</NexusPackageOutputDir>
            <ThunderstorePackageStagingDir>$(PackageStagingRoot)\Thunderstore\$(PackageName)</ThunderstorePackageStagingDir>
            <NexusPackageStagingDir>$(PackageStagingRoot)\Nexus\$(PackageName)</NexusPackageStagingDir>
            <PackageArtifactStagingDir>$(PackageStagingRoot)\Artifacts</PackageArtifactStagingDir>
            <ThunderstorePackageArtifact>$(PackageArtifactStagingDir)\Thunderstore\$(PackageName).zip</ThunderstorePackageArtifact>
            <NexusPackageArtifact>$(PackageArtifactStagingDir)\Nexus\$(PackageName).zip</NexusPackageArtifact>
            <ThunderstorePackageDestination>$(ThunderstorePackageOutputDir)\$(PackageName).zip</ThunderstorePackageDestination>
            <NexusPackageDestination>$(NexusPackageOutputDir)\$(PackageName).zip</NexusPackageDestination>
            <PowerShellExe Condition="'$(PowerShellExe)' == ''">powershell.exe</PowerShellExe>
        </PropertyGroup>
    </Target>

    <Target Name="DeployToGame" DependsOnTargets="Build">
        <Error Text="DLL not found in target directory." Condition="!Exists('$(TargetDir)$(AssemblyName).dll')"/>
        <Error Text="CopyOutputDLLPath is not configured." Condition="'$(CopyOutputDLLPath)' == ''"/>
        <Error Text="Configured game plugin directory '$(CopyOutputDLLPath)' does not exist." Condition="!Exists('$(CopyOutputDLLPath)')"/>
        <Copy SourceFiles="$(TargetDir)$(AssemblyName).dll" DestinationFolder="$(CopyOutputDLLPath)" OverwriteReadOnlyFiles="true"/>
        <Copy SourceFiles="$(TargetDir)$(AssemblyName).dll" DestinationFolder="$(CopyOutputDLLPath2)" OverwriteReadOnlyFiles="true" Condition="Exists('$(CopyOutputDLLPath2)')"/>
        <Copy SourceFiles="$(TargetDir)$(AssemblyName).dll" DestinationFolder="$(CopyOutputDLLPath3)" OverwriteReadOnlyFiles="true" Condition="Exists('$(CopyOutputDLLPath3)')"/>
    </Target>

    <Target Name="ValidatePackageReleaseInputs">
        <Error Text="PackageRelease requires Configuration=Release." Condition="'$(Configuration)' != 'Release'"/>
        <Error Text="README.md not found in project directory." Condition="!Exists('$(ProjectDir)README.md')"/>
        <Error Text="Thunderstore manifest.json not found in project directory." Condition="!Exists('$(ProjectDir)Thunderstore\manifest.json')"/>
        <Error Text="Thunderstore icon.png not found in project directory." Condition="!Exists('$(ProjectDir)Thunderstore\icon.png')"/>
        <Error Text="Thunderstore CHANGELOG.md not found in project directory." Condition="!Exists('$(ProjectDir)Thunderstore\CHANGELOG.md')"/>
        <Error Text="UpdateManifest.ps1 not found in project directory." Condition="!Exists('$(ProjectDir)UpdateManifest.ps1')"/>
    </Target>

    <Target Name="PreparePackageStaging">
        <Error Text="DLL not found in target directory." Condition="!Exists('$(TargetDir)$(AssemblyName).dll')"/>
        <RemoveDir Directories="$(ThunderstorePackageStagingDir);$(NexusPackageStagingDir);$(PackageArtifactStagingDir)"/>
        <MakeDir Directories="$(ThunderstorePackageStagingDir);$(NexusPackageStagingDir)"/>
        <ItemGroup>
            <ThunderstorePackageFiles Include="$(TargetDir)$(AssemblyName).dll"/>
            <ThunderstorePackageFiles Include="$(ProjectDir)README.md"/>
            <ThunderstorePackageFiles Include="$(ProjectDir)Thunderstore\CHANGELOG.md"/>
            <ThunderstorePackageFiles Include="$(ProjectDir)Thunderstore\manifest.json"/>
            <ThunderstorePackageFiles Include="$(ProjectDir)Thunderstore\icon.png"/>
            <NexusPackageFiles Include="$(TargetDir)$(AssemblyName).dll"/>
        </ItemGroup>
        <Copy SourceFiles="@(ThunderstorePackageFiles)" DestinationFolder="$(ThunderstorePackageStagingDir)"/>
        <Copy SourceFiles="@(NexusPackageFiles)" DestinationFolder="$(NexusPackageStagingDir)"/>
    </Target>

    <Target Name="UpdateManifestVersion">
        <Message Text="Updating Thunderstore manifest to version $(PackageVersion)."/>
        <Exec Command="&quot;$(PowerShellExe)&quot; -NoProfile -NonInteractive -ExecutionPolicy Bypass -File &quot;$(ProjectDir)UpdateManifest.ps1&quot; -Mode UpdateManifest -ManifestFile &quot;$(ProjectDir)Thunderstore\manifest.json&quot; -VersionString &quot;$(PackageVersion)&quot; -ExpectedName &quot;$(AssemblyName)&quot;"/>
    </Target>

    <Target Name="MakeThunderstorePackage">
        <MakeDir Directories="$(PackageArtifactStagingDir)\Thunderstore"/>
        <ZipDirectory SourceDirectory="$(ThunderstorePackageStagingDir)" DestinationFile="$(ThunderstorePackageArtifact)" Overwrite="true"/>
    </Target>

    <Target Name="MakeNexusPackage">
        <MakeDir Directories="$(PackageArtifactStagingDir)\Nexus"/>
        <ZipDirectory SourceDirectory="$(NexusPackageStagingDir)" DestinationFile="$(NexusPackageArtifact)" Overwrite="true"/>
    </Target>

    <Target Name="ValidateStagedPackages">
        <Exec Command="&quot;$(PowerShellExe)&quot; -NoProfile -NonInteractive -ExecutionPolicy Bypass -File &quot;$(ProjectDir)UpdateManifest.ps1&quot; -Mode ValidatePackage -ManifestFile &quot;$(ThunderstorePackageStagingDir)\manifest.json&quot; -VersionString &quot;$(PackageVersion)&quot; -ExpectedName &quot;$(AssemblyName)&quot; -IconFile &quot;$(ThunderstorePackageStagingDir)\icon.png&quot; -ThunderstoreZip &quot;$(ThunderstorePackageArtifact)&quot; -NexusZip &quot;$(NexusPackageArtifact)&quot; -DllFileName &quot;$(AssemblyName).dll&quot;"/>
    </Target>

    <Target Name="PromotePackageRelease">
        <Exec Command="&quot;$(PowerShellExe)&quot; -NoProfile -NonInteractive -ExecutionPolicy Bypass -File &quot;$(ProjectDir)UpdateManifest.ps1&quot; -Mode PromotePackages -ThunderstoreZip &quot;$(ThunderstorePackageArtifact)&quot; -NexusZip &quot;$(NexusPackageArtifact)&quot; -ThunderstoreDestination &quot;$(ThunderstorePackageDestination)&quot; -NexusDestination &quot;$(NexusPackageDestination)&quot;"/>
    </Target>

    <Target Name="CleanPackageStaging">
        <RemoveDir Directories="$(ThunderstorePackageStagingDir);$(NexusPackageStagingDir);$(PackageArtifactStagingDir)"/>
    </Target>

    <Target Name="PackageRelease"
            DependsOnTargets="ValidatePackageReleaseInputs;Build;GetAssemblyVersion;UpdateManifestVersion;PreparePackageStaging;MakeThunderstorePackage;MakeNexusPackage;ValidateStagedPackages;PromotePackageRelease;CleanPackageStaging">
        <Message Text="Created Thunderstore and Nexus packages for $(PackageName)." Importance="high"/>
    </Target>

</Project>
